{
  "$defs": {
    "CatalogueSourceSummary": {
      "properties": {
        "pluginCount": {
          "minimum": 0,
          "title": "Plugincount",
          "type": "integer"
        },
        "projectKindCounts": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "enum": [
              "plugin",
              "nomad_dependent_package",
              "distribution",
              "official_template",
              "official_software",
              "template_or_example",
              "ecosystem_package"
            ]
          },
          "title": "Projectkindcounts",
          "type": "object"
        },
        "registryVisibleCount": {
          "minimum": 0,
          "title": "Registryvisiblecount",
          "type": "integer"
        },
        "warningCount": {
          "minimum": 0,
          "title": "Warningcount",
          "type": "integer"
        }
      },
      "required": [
        "pluginCount",
        "registryVisibleCount",
        "projectKindCounts",
        "warningCount"
      ],
      "title": "CatalogueSourceSummary",
      "type": "object"
    },
    "DeploymentInfo": {
      "properties": {
        "onCentral": {
          "title": "Oncentral",
          "type": "boolean"
        },
        "onExampleOasis": {
          "title": "Onexampleoasis",
          "type": "boolean"
        }
      },
      "required": [
        "onCentral",
        "onExampleOasis"
      ],
      "title": "DeploymentInfo",
      "type": "object"
    },
    "Plugin": {
      "properties": {
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "deployment": {
          "$ref": "#/$defs/DeploymentInfo"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "discoveryWarnings": {
          "items": {
            "type": "string"
          },
          "title": "Discoverywarnings",
          "type": "array"
        },
        "documentationUrl": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Documentationurl"
        },
        "entrypoints": {
          "items": {
            "$ref": "#/$defs/PluginEntryPoint"
          },
          "title": "Entrypoints",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metadataSource": {
          "const": "pyproject.toml",
          "title": "Metadatasource",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "pluginTypes": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "schema",
                  "parser",
                  "normalizer",
                  "app",
                  "example_upload",
                  "api",
                  "north_tool",
                  "action",
                  "dashboard",
                  "unknown"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plugintypes"
        },
        "projectKind": {
          "enum": [
            "plugin",
            "nomad_dependent_package",
            "distribution",
            "official_template",
            "official_software",
            "template_or_example",
            "ecosystem_package"
          ],
          "title": "Projectkind",
          "type": "string"
        },
        "pypiUrl": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pypiurl"
        },
        "registryVisible": {
          "title": "Registryvisible",
          "type": "boolean"
        },
        "repositoryUrl": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Repositoryurl",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RepositoryStatus"
        }
      },
      "required": [
        "id",
        "name",
        "repositoryUrl",
        "owner",
        "status",
        "deployment",
        "projectKind",
        "registryVisible",
        "metadataSource"
      ],
      "title": "Plugin",
      "type": "object"
    },
    "PluginEntryPoint": {
      "properties": {
        "module": {
          "title": "Module",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "type": {
          "enum": [
            "schema",
            "parser",
            "normalizer",
            "app",
            "example_upload",
            "api",
            "north_tool",
            "action",
            "dashboard",
            "unknown"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "module",
        "type"
      ],
      "title": "PluginEntryPoint",
      "type": "object"
    },
    "RepositoryStatus": {
      "properties": {
        "archived": {
          "title": "Archived",
          "type": "boolean"
        },
        "createdAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Createdat"
        },
        "fork": {
          "title": "Fork",
          "type": "boolean"
        },
        "lastPushedAt": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastpushedat"
        },
        "stars": {
          "title": "Stars",
          "type": "integer"
        }
      },
      "required": [
        "archived",
        "fork",
        "stars"
      ],
      "title": "RepositoryStatus",
      "type": "object"
    }
  },
  "properties": {
    "dataUpdatedAt": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dataupdatedat"
    },
    "plugins": {
      "items": {
        "$ref": "#/$defs/Plugin"
      },
      "title": "Plugins",
      "type": "array"
    },
    "schemaVersion": {
      "const": "2.0.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "sourceSummary": {
      "$ref": "#/$defs/CatalogueSourceSummary"
    }
  },
  "required": [
    "schemaVersion",
    "sourceSummary",
    "plugins"
  ],
  "title": "CatalogueSnapshot",
  "type": "object"
}
